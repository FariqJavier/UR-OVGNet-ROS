<launch>
  <node pkg="ovgnet-ros" type="ros_ovgnet.py" name="ovgnet_node" output="screen">
    <param name="output_dir" value="$(find ovgnet-ros)/data"/>
    <param name="image_height" value="480"/>
    <param name="image_width" value="848"/>
    <param name="enable_color" value="True"/>
    <param name="enable_depth" value="True"/>
    <param name="enable_camera_info" value="True"/>
    <param name="use_mask" value="True"/>
    <param name="mask_margin_lr" value="0.2"/>
    <param name="mask_margin_tb" value="0.1"/>
    <param name="groundingdino_text_prompt" value="silver pen"/>
    <param name="groundingdino_config_path" value="$(find groundingdino-ros)/src/groundingdino/config/GroundingDINO_SwinT_OGC.py" />
    <param name="groundingdino_checkpoint_path" value="$(find groundingdino-ros)/src/groundingdino/weights/OVGANet.pth" />
    <param name="groundingdino_box_threshold" value="0.3"/>
    <param name="groundingdino_text_threshold" value="0.25"/>
    <!-- <param name="groundingdino_token_spans" value="None"/> -->
    <param name="groundingdino_cpu_only" value="False"/>
    <param name="graspnet_checkpoint_path" value="$(find graspnet-ros)/src/logs/log_rs/checkpoint.tar"/>
    <param name="grapnet_refine_approach_dist" value="0.01"/>
    <param name="graspnet_dist_thresh" value="0.1"/>
    <param name="graspnet_angle_thresh" value="30"/>
    <param name="graspnet_mask_thresh" value="1"/>
  </node>
</launch>