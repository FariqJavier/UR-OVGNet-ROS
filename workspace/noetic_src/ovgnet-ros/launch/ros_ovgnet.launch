<launch>
  <node pkg="ovgnet-ros" type="ros_ovgnet.py" name="ovgnet_node" output="screen">
    <param name="output_dir" value="$(find ovgnet-ros)/data"/>
    <param name="image_height" value="480"/>
    <param name="image_width" value="848"/>
    <param name="enable_color" value="True"/>
    <param name="enable_depth" value="False"/>
    <param name="enable_camera_info" value="False"/>
    <param name="use_mask" value="True"/>
    <param name="mask_margin_lr" value="0.2"/>
    <param name="mask_margin_tb" value="0.1"/>
    <param name="text_prompt" value="silver pen"/>
    <param name="config_path" value="$(find groundingdino-ros)/src/groundingdino/config/GroundingDINO_SwinT_OGC.py" />
    <param name="checkpoint_path" value="$(find groundingdino-ros)/src/groundingdino/weights/groundingdino_swint_ogc.pth" />
    <param name="box_threshold" value="0.3"/>
    <param name="text_threshold" value="0.25"/>
    <!-- <param name="token_spans" value="None"/> -->
    <param name="cpu_only" value="False"/>
  </node>
</launch>