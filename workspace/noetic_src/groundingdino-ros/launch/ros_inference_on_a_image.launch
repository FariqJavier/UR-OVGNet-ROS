<launch>
  <node pkg="groundingdino-ros" type="ros_inference_on_a_image.py" name="grounding_dino_node" output="screen">
    <param name="config_path" value="$(find groundingdino-ros)/src/groundingdino/config/GroundingDINO_SwinT_OGC.py" />
    <param name="checkpoint_path" value="$(find groundingdino-ros)/src/groundingdino/weights/groundingdino_swint_ogc.pth" />
    <param name="text_prompt" value="a remote"/>

    <!-- <param name="image_topic" value="/camera/color/image_raw"/> -->
    <param name="image_path" value="$(find groundingdino-ros)/doc/cats.png"/>

    <param name="output_dir" value="$(find groundingdino-ros)/doc/example_data"/>
  </node>
</launch>
